---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import LangDetect from '../components/LangDetect.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl } from '../i18n/utils';

export interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image = '/og.png' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
---

<html lang={lang} dir={lang === 'fa' ? 'rtl' : 'ltr'}>
	<head>
		<LangDetect currentLang={lang} />
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body class="min-h-screen flex flex-col items-center bg-bg text-text font-body text-lg leading-[1.7] antialiased overflow-x-clip max-[480px]:text-base">
		<Header />
		<main class="flex-1 w-[var(--site-width)] py-[var(--content-padding)]">
			<slot />
		</main>
		<Footer />

		<button
			id="back-to-top"
			class="fixed bottom-8 end-8 size-11 rounded-full bg-bg-hover backdrop-blur border border-accent-border text-light cursor-pointer flex items-center justify-center opacity-0 invisible translate-y-4 transition-all duration-300 ease-[cubic-bezier(0.4,0,0.2,1)] z-50 p-0 shadow-[0_4px_15px_rgba(0,0,0,0.3)] data-[show=true]:opacity-100 data-[show=true]:visible data-[show=true]:translate-y-0 hover:bg-accent-tint-strong hover:border-light hover:text-heading hover:-translate-y-1 hover:shadow-[0_6px_20px_var(--accent-border)]"
			aria-label="Go to top"
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<polyline points="18 15 12 9 6 15"></polyline>
			</svg>
		</button>

		<script>
			const backToTop = document.getElementById('back-to-top');

			if (backToTop) {
				const toggleBackToTop = () => {
					if (window.scrollY > 300) {
						backToTop.setAttribute('data-show', 'true');
					} else {
						backToTop.removeAttribute('data-show');
					}
				};

				window.addEventListener('scroll', toggleBackToTop, { passive: true });

				backToTop.addEventListener('click', () => {
					window.scrollTo({
						top: 0,
						behavior: 'smooth'
					});
				});
			}
		</script>
	</body>
</html>
