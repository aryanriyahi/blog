---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ui, defaultLang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE_CONFIG } from '../../../config';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  
  const paths = allPosts.flatMap((post) => {
    const [postLang, ...slug] = post.id.split('/');
    const lang = postLang === defaultLang ? undefined : postLang;
    const tags = post.data.tags || [];
    
    return tags.map((tag: string) => ({
      params: { lang, tag },
    }));
  });
  
  // Deduplicate using params nesting
  const uniquePaths = Array.from(
    new Map(paths.map(p => [`${p.params.lang || 'default'}-${p.params.tag}`, p.params])).values()
  );
  
  return uniquePaths.map((p) => ({
    params: { lang: p.lang, tag: p.tag },
  }));
}

const { lang, tag } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof ui);

const posts = await getCollection('blog', (post: CollectionEntry<'blog'>) => {
  return post.id.startsWith(`${currentLang}/`) && (post.data.tags || []).includes(tag);
});

posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const pageTitle = `${SITE_CONFIG.title} | #${tag}`;
const pageDescription = currentLang === 'fa' 
  ? `همه نوشته‌های دارای برچسب "${tag}"` 
  : `All posts tagged with "${tag}"`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<div class="mb-12">
		<a href={getRelativeLocaleUrl(currentLang, 'tags')} class="inline-flex items-center gap-2 text-[0.9rem] text-light no-underline mb-6 transition-all duration-200 hover:text-heading ltr:hover:-translate-x-[3px] rtl:hover:translate-x-[3px]">
			<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 rtl:-scale-x-100"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
			{t('tags.title')}
		</a>
		<h1 class="mt-0 mb-2">#{tag}</h1>
		<p class="text-[1.05rem] text-muted m-0">{pageDescription}</p>
	</div>

	<section>
		{posts.length > 0 ? (
			<ul class="list-none p-0 m-0">
				{posts.map((post) => {
					const slugWithoutLang = post.id.replace(`${currentLang}/`, '');
					return (
						<li class="mb-0">
							<a href={getRelativeLocaleUrl(currentLang, `blog/${slugWithoutLang}`)} class="group flex flex-col no-underline py-[0.85rem] border-b border-border-faint transition-all duration-200 hover:ps-2 sm:flex-row sm:justify-between sm:items-center">
								<span class="text-[clamp(1rem,2.5vw,1.15rem)] font-semibold text-light transition-colors duration-200 group-hover:text-text">{post.data.title}</span>
								<span class="text-[0.85rem] text-faint mt-[0.15rem] sm:mt-0 sm:shrink-0 sm:ms-4">
									{post.data.pubDate.toLocaleDateString(currentLang, {
										year: 'numeric',
										month: 'long',
										day: 'numeric',
									})}
								</span>
							</a>
						</li>
					);
				})}
			</ul>
		) : (
			<p class="text-faint italic">{currentLang === 'fa' ? 'نوشته‌ای با این برچسب یافت نشد.' : 'No posts found with this tag.'}</p>
		)}
	</section>
</BaseLayout>
