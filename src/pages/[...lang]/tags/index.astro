---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ui, defaultLang } from '../../../i18n/ui';
import { useTranslations } from '../../../i18n/utils';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE_CONFIG } from '../../../config';

export function getStaticPaths() {
  return Object.keys(ui).map((lang) => {
    return { params: { lang: lang === defaultLang ? undefined : lang } };
  });
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof ui);

const pageTitle = `${SITE_CONFIG.title} | ${t('tags.title')}`;
const pageDescription = t('tags.description');

const posts: CollectionEntry<'blog'>[] = await getCollection('blog', (post: CollectionEntry<'blog'>) => {
  return post.id.startsWith(`${currentLang}/`);
});

// Count posts per tag
const tagCounts = posts.reduce<Record<string, number>>((acc, post) => {
  const tags = post.data.tags || [];
  tags.forEach((tag: string) => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<section class="mb-12">
		<h1>{t('tags.title')}</h1>
		<p>{t('tags.description')}</p>
	</section>

	<section>
		{sortedTags.length > 0 ? (
			<div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] gap-4 mt-4 sm:gap-6">
				{sortedTags.map(([tag, count]) => (
					<a href={getRelativeLocaleUrl(currentLang, `tags/${tag}`)} class="group flex flex-col py-5 px-6 bg-bg-panel border border-accent-tint rounded-lg no-underline transition-all duration-200 hover:bg-bg-hover hover:border-light hover:-translate-y-0.5">
						<span class="text-[1.2rem] font-semibold text-light mb-1 transition-colors duration-200 group-hover:text-heading">#{tag}</span>
						<span class="text-[0.85rem] text-faint">
							{count} {t('tags.postsCount')}
						</span>
					</a>
				))}
			</div>
		) : (
			<p class="text-faint italic">{currentLang === 'fa' ? 'برچسبی یافت نشد.' : currentLang === 'de' ? 'Keine Tags gefunden.' : 'No tags found.'}</p>
		)}
	</section>
</BaseLayout>
