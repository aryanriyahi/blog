---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Profile from '../../components/Profile.astro';
import { getCollection } from 'astro:content';
import { ui, defaultLang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE_CONFIG } from '../../config';

export function getStaticPaths() {
  return Object.keys(ui).map((lang) => {
    return { params: { lang: lang === defaultLang ? undefined : lang } };
  });
}

const { lang } = Astro.params;
const currentLang = lang || defaultLang;
const t = useTranslations(currentLang as keyof typeof ui);

const pageTitle = `${SITE_CONFIG.title} | ${t('home.title')}`;
const pageDescription = t('home.subtitle');

const posts: CollectionEntry<'blog'>[] = await getCollection('blog', (post: CollectionEntry<'blog'>) => {
  return post.id.startsWith(`${currentLang}/`);
});
posts.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const archiveLabel = currentLang === 'fa' ? 'همه نوشته‌ها →' : 'All posts →';
---

<BaseLayout title={pageTitle} description={pageDescription}>
	<div class="grid grid-cols-1 gap-8 items-start min-[860px]:grid-cols-[1fr_3fr] min-[860px]:gap-16">
		<aside class="self-start min-[860px]:sticky min-[860px]:top-8">
			<Profile />
		</aside>
		
		<div>
			<section>
				<h2 class="text-xl border-b border-border pb-2 mt-0 mb-6">{t('nav.archive')}</h2>
				<div class="relative max-h-[380px] overflow-hidden flex flex-col sm:max-h-[520px]">
					<ul class="list-none p-0 pe-1 flex-1 min-h-0">
						{
							posts.map((post) => {
								const slugWithoutLang = post.id.replace(`${currentLang}/`, '');
								return (
									<li class="mb-3">
										<a href={getRelativeLocaleUrl(currentLang, `blog/${slugWithoutLang}`)} class="group flex flex-col no-underline px-[0.9rem] py-3 rounded-lg border border-transparent transition-all duration-200 hover:bg-bg-hover hover:border-accent-border ltr:hover:translate-x-1 rtl:hover:-translate-x-1 sm:flex-row sm:justify-between sm:items-center">
											<span class="text-[clamp(1rem,2.5vw,1.15rem)] font-semibold text-light transition-colors duration-200 mb-[0.3rem] group-hover:text-text sm:mb-0">{post.data.title}</span>
											<span class="text-[0.82rem] text-faint">
												{post.data.pubDate.toLocaleDateString(currentLang, {
													year: 'numeric',
													month: 'long',
													day: 'numeric',
												})}
											</span>
										</a>
									</li>
								);
							})
						}
					</ul>
					<div class="absolute bottom-0 start-0 end-0 h-[90px] flex items-end justify-center pointer-events-none [background:linear-gradient(to_bottom,transparent_0%,var(--bg-color)_65%)] min-[860px]:justify-start">
						<a href={getRelativeLocaleUrl(currentLang, 'archive')} class="text-[0.9rem] text-muted no-underline transition-colors duration-200 py-1 pointer-events-auto hover:text-light">{archiveLabel}</a>
					</div>
				</div>
			</section>
		</div>
	</div>
</BaseLayout>
