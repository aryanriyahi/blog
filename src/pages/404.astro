---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const content = {
    title: t('notFound.title'),
    heading: '404',
    sub: t('notFound.sub'),
    body: t('notFound.body'),
    home: t('notFound.home'),
    archive: t('notFound.archive'),
    homeHref: getRelativeLocaleUrl(lang, ''),
    archiveHref: getRelativeLocaleUrl(lang, 'blog'),
};
---

<BaseLayout title={content.title} description={content.sub}>
    <div class="flex flex-col items-start justify-center min-h-[60vh] gap-6">
        <span class="text-[clamp(6rem,15vw,12rem)] font-bold leading-none text-transparent tracking-[-0.05em] select-none [-webkit-text-stroke:2px_var(--accent-tint-strong)]">404</span>
        <h1 class="text-[clamp(1.5rem,4vw,2.5rem)] mt-0 text-heading">{content.sub}</h1>
        <p class="text-lg text-muted max-w-[480px] leading-[1.7] mb-0">{content.body}</p>
        <div class="flex gap-4 flex-wrap mt-2">
            <a href={content.homeHref} class="px-[1.4rem] py-[0.6rem] rounded-md text-[0.95rem] font-semibold transition-all duration-200 no-underline bg-accent text-white hover:bg-light hover:text-bg">{content.home}</a>
            <a href={content.archiveHref} class="px-[1.4rem] py-[0.6rem] rounded-md text-[0.95rem] font-semibold transition-all duration-200 no-underline text-light border border-accent-border hover:border-light hover:text-heading">{content.archive}</a>
        </div>
    </div>
</BaseLayout>
