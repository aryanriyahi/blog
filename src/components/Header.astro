---
import { getLangFromUrl, useTranslations, getRouteFromUrl } from '../i18n/utils';
import { languages } from '../i18n/ui';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE_CONFIG } from '../config';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Icon } from 'astro-icon/components';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const route = getRouteFromUrl(Astro.url);

// Fetch all posts to handle translation mapping
const allPosts: CollectionEntry<'blog'>[] = await getCollection('blog');
const isPost = route?.startsWith('blog/');
let currentTranslationKey: string | undefined = undefined;

if (isPost && route) {
	const currentSlug = route.replace('blog/', '').replace(/\/$/, '');
	const currentPost = allPosts.find(p => p.id === `${lang}/${currentSlug}`);
	if (currentPost) {
		currentTranslationKey = currentPost.data.translationKey;
	}
}
---

<header class="w-[var(--site-width)] py-6">
	<nav class="flex flex-wrap justify-between items-center gap-3 sm:flex-nowrap">
		<div>
			<a href={getRelativeLocaleUrl(lang, '')} class="text-2xl font-bold text-heading tracking-tight hover:text-accent">{SITE_CONFIG.title}</a>
		</div>
		<div class="flex gap-6 order-3 w-full justify-center sm:order-none sm:w-auto sm:justify-start">
			<a href={getRelativeLocaleUrl(lang, '')} class="text-[0.95rem] font-medium text-light hover:text-heading">{t('nav.home')}</a>
			<a href={getRelativeLocaleUrl(lang, 'archive')} class="text-[0.95rem] font-medium text-light hover:text-heading">{t('nav.archive')}</a>
			<a href={getRelativeLocaleUrl(lang, 'tags')} class="text-[0.95rem] font-medium text-light hover:text-heading">{t('nav.tags')}</a>
			<a href={getRelativeLocaleUrl(lang, 'about')} class="text-[0.95rem] font-medium text-light hover:text-heading">{t('nav.about')}</a>
		</div>
		<div class="flex items-center gap-3 ms-auto sm:ms-0">
			<button id="theme-toggle" class="theme-toggle flex items-center justify-center size-8 text-[1.15rem] rounded-md border border-border-faint bg-bg-panel text-muted cursor-pointer p-0 transition-all duration-200 hover:text-heading hover:bg-bg-hover hover:border-border" type="button" aria-label="Toggle color theme" title="Toggle theme">
				<Icon name="mdi:weather-sunny" class="icon-sun" />
				<Icon name="mdi:weather-night" class="icon-moon" />
			</button>
			<div class="lang-switcher">
				<ul class="flex gap-2 list-none m-0 p-0">
					{Object.entries(languages).map(([abbr, label]) => {
						let targetRoute = route || '';
						
						if (targetRoute.startsWith('blog/') && lang !== abbr) {
							let matchedPost;
							if (currentTranslationKey) {
								matchedPost = allPosts.find(p => p.id.startsWith(`${abbr}/`) && p.data.translationKey === currentTranslationKey);
							}
							
							if (matchedPost) {
								const targetSlug = matchedPost.id.replace(`${abbr}/`, '');
								targetRoute = `blog/${targetSlug}/`;
							} else {
								targetRoute = 'archive/';
							}
						}
						
						return (
						<li>
							<a href={getRelativeLocaleUrl(abbr, targetRoute)} class={`text-[0.85rem] font-semibold px-[0.4rem] py-[0.2rem] rounded hover:text-heading hover:bg-bg-hover ${lang === abbr ? 'text-bg bg-light' : 'text-faint'}`}>
								{abbr.toUpperCase()}
							</a>
						</li>
					);
					})}
				</ul>
			</div>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById('theme-toggle');
	if (toggle) {
		toggle.addEventListener('click', () => {
			const root = document.documentElement;
			const next = root.dataset.theme === 'light' ? 'dark' : 'light';
			root.dataset.theme = next;
			localStorage.setItem('theme', next);
		});

		// Follow system preference when the user hasn't chosen manually
		const mq = window.matchMedia('(prefers-color-scheme: light)');
		mq.addEventListener('change', (e) => {
			if (!localStorage.getItem('theme')) {
				document.documentElement.dataset.theme = e.matches ? 'light' : 'dark';
			}
		});
	}
</script>
