---
import { getLangFromUrl, useTranslations, getRouteFromUrl } from '../i18n/utils';
import { languages } from '../i18n/ui';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE_CONFIG } from '../config';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Icon } from 'astro-icon/components';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const route = getRouteFromUrl(Astro.url);

// Fetch all posts to handle translation mapping
const allPosts: CollectionEntry<'blog'>[] = await getCollection('blog');
const isPost = route?.startsWith('blog/');
let currentTranslationKey: string | undefined = undefined;

if (isPost && route) {
	const currentSlug = route.replace('blog/', '').replace(/\/$/, '');
	const currentPost = allPosts.find(p => p.id === `${lang}/${currentSlug}`);
	if (currentPost) {
		currentTranslationKey = currentPost.data.translationKey;
	}
}
---
<header class="site-header">
	<nav>
		<div class="logo">
			<a href={getRelativeLocaleUrl(lang, '')}>{SITE_CONFIG.title}</a>
		</div>
		<div class="links">
			<a href={getRelativeLocaleUrl(lang, '')}>{t('nav.home')}</a>
			<a href={getRelativeLocaleUrl(lang, 'archive')}>{t('nav.archive')}</a>
			<a href={getRelativeLocaleUrl(lang, 'tags')}>{t('nav.tags')}</a>
			<a href={getRelativeLocaleUrl(lang, 'about')}>{t('nav.about')}</a>
		</div>
		<div class="header-actions">
			<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle theme">
				<Icon name="mdi:weather-sunny" class="icon-sun" />
				<Icon name="mdi:weather-night" class="icon-moon" />
			</button>
			<div class="lang-switcher">
				<ul>
				{Object.entries(languages).map(([abbr, label]) => {
					let targetRoute = route || '';
					
					if (targetRoute.startsWith('blog/') && lang !== abbr) {
						let matchedPost;
						if (currentTranslationKey) {
							matchedPost = allPosts.find(p => p.id.startsWith(`${abbr}/`) && p.data.translationKey === currentTranslationKey);
						}
						
						if (matchedPost) {
							const targetSlug = matchedPost.id.replace(`${abbr}/`, '');
							targetRoute = `blog/${targetSlug}/`;
						} else {
							targetRoute = 'archive/';
						}
					}
					
					return (
					<li>
						<a href={getRelativeLocaleUrl(abbr, targetRoute)} class={lang === abbr ? 'active' : ''}>
							{abbr.toUpperCase()}
						</a>
					</li>
					);
				})}
				</ul>
			</div>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById('theme-toggle');
	if (toggle) {
		toggle.addEventListener('click', () => {
			const root = document.documentElement;
			const next = root.dataset.theme === 'light' ? 'dark' : 'light';
			root.dataset.theme = next;
			localStorage.setItem('theme', next);
		});

		// Follow system preference when the user hasn't chosen manually
		const mq = window.matchMedia('(prefers-color-scheme: light)');
		mq.addEventListener('change', (e) => {
			if (!localStorage.getItem('theme')) {
				document.documentElement.dataset.theme = e.matches ? 'light' : 'dark';
			}
		});
	}
</script>


<style>
	.site-header {
		width: var(--site-width);
		padding: 1.5rem 0;
		margin-left: auto;
		margin-right: auto;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
	}

	.logo a {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--heading-color);
		letter-spacing: -0.02em;
	}
	
	.logo a:hover {
		color: var(--accent);
	}

	.links {
		display: flex;
		gap: 1.5rem;
		/* On mobile this wraps below logo/lang row */
		order: 3;
		width: 100%;
		justify-content: center;
	}

	.links a {
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--light);
	}

	.links a:hover {
		color: var(--heading-color);
	}

	.header-actions {
		/* Stays right side with logo on mobile */
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-inline-start: auto;
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		font-size: 1.15rem;
		border-radius: 6px;
		border: 1px solid var(--border-faint);
		background: var(--bg-panel);
		color: var(--text-muted);
		cursor: pointer;
		padding: 0;
		transition: all var(--transition-speed) ease;
	}

	.theme-toggle:hover {
		color: var(--heading-color);
		background: var(--bg-hover);
		border-color: var(--border);
	}

	.theme-toggle:focus-visible {
		outline: 2px dashed var(--accent);
		outline-offset: 2px;
	}

	.lang-switcher ul {
		display: flex;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.lang-switcher a {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-faint);
		padding: 0.2rem 0.4rem;
		border-radius: 4px;
	}

	.lang-switcher a:hover {
		color: var(--heading-color);
		background: var(--bg-hover);
	}

	.lang-switcher a.active {
		color: var(--bg-color);
		background: var(--light);
	}

	/* Desktop: restore three-column flex, no wrapping */
	@media (min-width: 640px) {
		nav {
			flex-wrap: nowrap;
		}

		.links {
			order: unset;
			width: auto;
			justify-content: flex-start;
		}

		.header-actions {
			margin-inline-start: 0;
		}
	}
</style>
