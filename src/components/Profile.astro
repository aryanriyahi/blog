---
import { Image } from "astro:assets";
import { getLangFromUrl } from "../i18n/utils";
import { Icon } from "astro-icon/components";
import { AUTHOR, SOCIALS } from "../config";
import avatarImage from "../assets/profile.jpg";
import { getRelativeLocaleUrl } from "astro:i18n";

const lang = getLangFromUrl(Astro.url);
const role = AUTHOR.role[lang as keyof typeof AUTHOR.role] ?? AUTHOR.role.en;
const bio = AUTHOR.bio[lang as keyof typeof AUTHOR.bio] ?? AUTHOR.bio.en;
---

<div class="flex flex-col items-center text-center">
    <div class="size-[300px] rounded-full overflow-hidden mb-6 border border-accent max-[859px]:hidden">
        <Image
            src={avatarImage}
            alt={`${AUTHOR.name} profile picture`}
            width={300}
            height={300}
            loading="eager"
            class="w-full h-full object-cover"
        />
    </div>

    <div>
        <h2 class="text-3xl mb-1 text-heading">{AUTHOR.name}</h2>
        <span class="block text-sm text-accent font-semibold mb-4">{role}</span>
        <p class="text-[0.95rem] leading-relaxed text-soft mb-6 break-words">{bio}</p>
    </div>

    <div class="flex flex-wrap gap-4 justify-center">
        {
            SOCIALS.map((social) => {
                const href =
                    social.label === "RSS" ? getRelativeLocaleUrl(lang, "rss.xml") : social.href;

                return (
                    <a
                        href={href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={social.label}
                        class="flex items-center justify-center size-10 rounded-full bg-border-faint text-light text-xl transition-all duration-200 hover:bg-accent hover:text-white hover:-translate-y-0.5"
                    >
                        <Icon name={social.icon} />
                    </a>
                );
            })
        }
    </div>
</div>
