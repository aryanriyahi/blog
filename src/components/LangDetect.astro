---
const { currentLang = 'fa' } = Astro.props;
---

<!--
  Runs early in <head>, before paint, to avoid showing the wrong
  language. Priority:
    1. localStorage 'preferredLang' (manual override) always wins.
    2. Otherwise: Iran timezone -> fa, everyone else -> en.
    3. If resolved lang differs from the current URL's lang, redirect
       to the correct locale URL (replacing history entry).
-->
<script is:inline define:vars={{ currentLang }}>
	(function () {
		var saved = null;
		try { saved = window.localStorage.getItem('preferredLang'); } catch (e) {}

		var wanted = null;
		if (saved === 'fa' || saved === 'en') {
			wanted = saved;
		} else {
			try {
				var off = Math.abs(new Date().getTimezoneOffset());
				// Iran: GMT+3:30 or GMT+4:30 (DST) -> -210 / -270
				wanted = (off === 210 || off === 270) ? 'fa' : 'en';
			} catch (e) {
				wanted = 'en';
			}
		}

		if (!wanted || wanted === currentLang) return;

		var curPrefix = currentLang === 'fa' ? '' : currentLang + '/';
		var rest = window.location.pathname;
		if (curPrefix) {
			rest = rest.replace(new RegExp('^/' + curPrefix), '');
		}
		var newPath = (wanted === 'fa' ? '' : wanted + '/') + rest.replace(/^\//, '');
		var newUrl = window.location.origin + '/' + newPath
			+ window.location.search + window.location.hash;
		newUrl = newUrl.replace(/([^:])\/+/g, '$1/');
		window.location.replace(newUrl);
	})();
</script>
